# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Canonical production site URL (no trailing slash). Used by Next.js
# Metadata's metadataBase (resolves relative OG/Twitter image URLs), and by
# app/robots.ts / app/sitemap.ts to build absolute URLs. Safe to leave unset
# in development — falls back to http://localhost:3000 (see lib/seo.ts).
# Set to the real production domain before going live.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Get these from Project Settings -> API in the Supabase dashboard. Every
# repository/context in this app is dual-mode (see lib/supabase/config.ts's
# isSupabaseConfigured()): unset, the app runs entirely on static/mock data
# for local development. In production, leaving these unset shows a visible
# "not connected" banner/screen instead of silently serving fake data — it
# is never a substitute for a real project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by trusted server code (e.g. guest order Server Actions,
# the payment webhook route) that must bypass RLS deliberately. Never import
# this in a "use client" file or expose it to the browser — it is not
# prefixed with NEXT_PUBLIC_ specifically so a build fails loudly if it ever
# leaks into client code that tries to read it from process.env.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payment providers (STEP 11) — all server-only, never NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Until these are set, every market resolves to the built-in MOCK payment
# provider in development/preview (see lib/payments/registry.ts); in a
# production build, an unconfigured market instead refuses to prepare a
# payment rather than silently using MOCK. Provider names are placeholders —
# swap in whichever PG is actually contracted (e.g. Toss Payments / PortOne
# for Korea, Razorpay for India, Stripe for everywhere else) and rename
# these to match once decided.

# Korea
KOREA_PG_CLIENT_KEY=
KOREA_PG_SECRET_KEY=

# India
INDIA_PG_KEY_ID=
INDIA_PG_KEY_SECRET=

# Global / USD fallback provider
GLOBAL_PG_PUBLIC_KEY=
GLOBAL_PG_SECRET_KEY=

# ---------------------------------------------------------------------------
# Internal / Ops
# ---------------------------------------------------------------------------
# Shared secret for app/api/internal/cancel-stale-orders — a scheduled job
# (see vercel.json's crons entry) hits this route to cancel unpaid orders
# older than app_settings.'orders.stale_cancel_minutes'. The route refuses
# every request until this is set (closed by default). Generate a random
# value (e.g. `openssl rand -hex 32`) — Vercel Cron automatically sends it
# as `Authorization: Bearer $CRON_SECRET` when this variable is set in the
# project's environment variables.
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI Product Assistant (STEP 16/17) — admin-only drafting aid, never NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# mock | openai. Unset = auto: prefers openai once OPENAI_API_KEY is set,
# else mock. An explicit `openai` with no key falls back to mock in
# development but is refused (503, "provider not configured") in
# production rather than silently mocking a real admin request.
# AI_PRODUCT_PROVIDER=

# Server-only — never exposed to the browser, never used outside
# lib/ai/productAssistant/providers/openai.ts's own fetch call.
# OPENAI_API_KEY=

# Defaults to gpt-4o-mini (see lib/ai/productAssistant/config.ts's
# DEFAULT_OPENAI_MODEL — the only place that fallback is defined) if unset.
# OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Future providers (not yet integrated — placeholders for Production TODO)
# ---------------------------------------------------------------------------
# Real exchange-rate source. Until set, lib/currency.ts's DEV_EXCHANGE_RATES
# is a development-only placeholder that a production build refuses to use
# for real order pricing (see lib/actions/order.ts) — a product without an
# explicit Market/Currency price simply cannot be purchased in that currency
# yet, rather than being sold at a fake rate.
# EXCHANGE_RATE_API_KEY=

# Transactional email/SMS (order confirmation, shipping updates). Not wired
# to any provider yet.
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=

# Real vision-based image search provider (see lib/imageSearch/registry.ts's
# FUTURE_VISION_PROVIDER stub). The current MOCK provider is dev-only and is
# hard-blocked in production builds regardless of this variable.
# IMAGE_SEARCH_VISION_API_KEY=
