# Supabase project connection. Get these from Project Settings → API in the Supabase dashboard.
# Never put the service_role key behind a NEXT_PUBLIC_ prefix — it must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by trusted server code (e.g. guest order Server Actions) that must
# bypass RLS deliberately. Never import this in a "use client" file or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# STEP 11: payment provider credentials. All server-only — never NEXT_PUBLIC_,
# never referenced from a "use client" file. Until these are set, every
# market resolves to the built-in MOCK payment provider (see
# lib/payments/registry.ts); no real charge is ever attempted. Provider
# names are placeholders — swap in whichever PG is actually contracted
# (e.g. Toss Payments / PortOne for Korea, Razorpay for India, Stripe for
# everywhere else) and rename these to match once decided.
KOREA_PG_CLIENT_KEY=
KOREA_PG_SECRET_KEY=

INDIA_PG_KEY_ID=
INDIA_PG_KEY_SECRET=

GLOBAL_PG_PUBLIC_KEY=
GLOBAL_PG_SECRET_KEY=
